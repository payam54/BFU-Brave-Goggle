! name: BFU Brave Goggle
! description: Excludes websites unrelated to BFU's frontier search from Brave Search results.
! public: true
! author: payam54

! Boost government, education, and municipal TLDs
*.gov^$boost=3
*.edu^$boost=2
*.city^$boost=3
*.town^$boost=3

! Boost all domains (this covers *.state.us)
*.art^$boost
*.us^$boost
*.org^$boost
*.yoga^$boost
*.group^$boost
*.center^$boost
*.beer^$boost
*.community^$boost
*.dance^$boost
*.dog^$boost
*.fishing^$boost
*.ngo^$boost
*.pet^$boost
*.tours^$boost
*.vacations^$boost
*.wine^$boost
*.college^$boost
*.university^$boost

! Boost specific municipal and tourism domain patterns
.gov/*events/$boost=5
cityof*.gov^$boost=5
cityof*.org^$boost=4
cityof*.com^$boost=3
cityof*.us^$boost=3
visit*.com^$boost=2

! Boost specific URL paths
/event/$boost
/?event=$boost
/events/$boost
/calendar/$boost
/library/$boost

! Downrank websites that are less likey useful
.tv^$downrank=2
.ai^$downrank=2
.net^$downrank

! Discard in domain level
.online^$discard
.pictures^$discard
.photos^$discard
.digital^$discard
.email^$discard
.website^$discard
.careers^$discard
.app^$discard
.casino^$discard
.chat^$discard
.construction^$discard
.consulting^$discard
.contact^$discard
.holdings^$discard
.rent^$discard
.rentals^$discard
.tax^$discard

! Discard specific URL paths
/pinterest/$discard
/instagram/$discard
/meetings/$discard
/meeting/$discard
/board/$discard


! Discard websites
