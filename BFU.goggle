! name: BFU Brave Goggle
! description: Excludes websites unrelated to BFU's frontier search from Brave Search results.
! public: false
! author: payam54

! Boost government, education, and municipal TLDs
*.gov^$boost=2
*.city^$boost=3
*.town^$boost=2
*.edu^$boost

! Boost all domains (this covers *.state.us)
*.art^$boost
*.us^$boost
*.org^$boost
*.yoga^$boost
*.group^$boost
*.center^$boost
*.beer^$boost
*.community^$boost
*.dance^$boost
*.dog^$boost
*.fishing^$boost
*.ngo^$boost
*.pet^$boost
*.tours^$boost
*.vacations^$boost
*.wine^$boost
*.college^$boost
*.university^$boost
*.macaronikid.com^$boost

! Boost websites
$boost,site=yodel.today


! Boost specific URL paths
/?event=$boost=2
/&event=$boost=2
/library/*events^$boost=3
/libraries/*events^$boost=3
/library/*calendar^$boost=3
/event^$boost=2
/events^$boost=2
/upcoming-events^$boost=3
/event-calendar^$boost=3
/events-calendar^$boost=3
/community-calendar^$boost=3
/calendar/events^$boost=3
/things-to-do^$boost=2
/whats-on^$boost=2
*calendar/events*$boost=2
*calendar.aspx?eid=$boost=4


! Downrank websites that are less likey useful
.tv^$downrank=2
.ai^$downrank=2
/*meeting*^$downrank=3
/*forum*^$downrank=3

! Discard in domain level
.online^$discard
.pictures^$discard
.photos^$discard
.digital^$discard
.email^$discard
.website^$discard
.careers^$discard
.app^$discard
.casino^$discard
.chat^$discard
.construction^$discard
.consulting^$discard
.contact^$discard
.holdings^$discard
.rent^$discard
.rentals^$discard
.tax^$discard
.uk^$discard
.au^$discard
.nz^$discard
.ie^$discard
.ca^$discard
.scot^$discard
.church^$discard

! Discard specific URL paths
/*agenda*$discard
/Agenda*$discard
/*commettee*$discard
/board/$discard
/instagram/$discard
/pinterest/$discard
/worship/$discard

